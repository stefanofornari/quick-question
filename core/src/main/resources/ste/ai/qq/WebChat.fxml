<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import ste.vnc.viewer.VNCViewer?>
<?import ste.ai.qq.TopHidingToolBar?>

<fx:root
    xmlns:fx="http://javafx.com/javafx/1"
    fx:id="webChat"
    type="StackPane"
    stylesheets="@TopHidingToolBar.css"
>
    <!-- Background Viewer -->
    <!-- Centering wrapper: fills the full WebChat area and keeps the viewer centered at its pref size -->
    <StackPane maxWidth="-Infinity" maxHeight="-Infinity" StackPane.alignment="TOP_CENTER">
        <VNCViewer fx:id="viewer" prefWidth="600" prefHeight="800" connect="AUTO" uri="vnc://localhost:5905" reconnectTimeout="3s"/>
    </StackPane>

    <!-- Sliding Toolbar pinned to top and wrapped strictly to pref size -->
    <TopHidingToolBar StackPane.alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity">
        <Button id="CHATGPT" fx:id="gptButton" onAction="#onSwitch" styleClass="provider-button">
            <graphic>
                <ImageView fitHeight="64.0" fitWidth="64.0">
                    <image>
                        <Image url="@chatgpt-logo-128x128.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>
        <Button id="CLAUDE" fx:id="claudeButton" onAction="#onSwitch" styleClass="provider-button">
            <graphic>
                <ImageView fitHeight="64.0" fitWidth="64.0">
                    <image>
                        <Image url="@claude-logo-128x128.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>
        <Button id="GEMINI" fx:id="geminiButton" onAction="#onSwitch" styleClass="provider-button">
            <graphic>
                <ImageView fitHeight="64.0" fitWidth="64.0">
                    <image>
                        <Image url="@gemini-logo-128x128.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>
        <Button id="MISTRAL" fx:id="mistralButton" onAction="#onSwitch" styleClass="provider-button">
            <graphic>
                <ImageView fitHeight="64.0" fitWidth="64.0">
                    <image>
                        <Image url="@mistral-logo-128x128.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>
        <Button id="PERPLEXITY" fx:id="perplexityButton" onAction="#onSwitch" styleClass="provider-button">
            <graphic>
                <ImageView fitHeight="64.0" fitWidth="64.0">
                    <image>
                        <Image url="@perplexity-logo-128x128.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>
    </TopHidingToolBar>
</fx:root>