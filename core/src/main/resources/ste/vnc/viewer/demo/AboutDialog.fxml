<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<fx:root fx:id="root" alignment="CENTER" maxWidth="420.0" prefWidth="420.0" spacing="16.0" styleClass="about-dialog" type="VBox" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="ste.vnc.viewer.demo.AboutDialogController">
    <children>
        <VBox alignment="CENTER" spacing="8.0">
            <children>
                <StackPane styleClass="about-icon-frame">
                    <children>
                        <ImageView fx:id="appIcon" fitHeight="64.0" fitWidth="64.0" pickOnBounds="true" preserveRatio="true" />
                    </children>
                </StackPane>
                <Label styleClass="about-title" text="QuickQuestion Demo" />
                <Label styleClass="about-version" text="Version ${project.version}" />
            </children>
        </VBox>
        <Separator styleClass="about-separator" />
        <Label maxWidth="Infinity" styleClass="about-text" text="A JavaFX demo application showcasing the QuickQuestion control in action.&#10;This application allows to launch your favorite AI web chat directly inside a JavaFX scene." textAlignment="CENTER" wrapText="true" />
        <Separator styleClass="about-separator" />
        <VBox alignment="CENTER" spacing="4.0">
            <children>
                <Label styleClass="about-copyright" text="Copyright (C) 2026 VNC Viewer Contributors" />
                <Label styleClass="about-license" text="Licensed under the GNU General Public License v2.0" />
            </children>
        </VBox>
        <Button fx:id="closeButton" defaultButton="true" styleClass="about-close-button" text="Close" />
    </children>
</fx:root>
