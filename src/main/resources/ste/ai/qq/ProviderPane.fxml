<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="25.0" styleClass="provider-container" stylesheets="@QuickQuestion.css" BorderPane.alignment="CENTER" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ste.ai.qq.demo.ProviderPaneController">
    <children>
        <Button id="gptButton" fx:id="gptButton" onAction="#onSwitch" styleClass="provider-button">
            <graphic>
                <ImageView fitHeight="75.0" fitWidth="75.0" style="-fx-width: 75;">
                    <image>
                        <Image url="@chatgpt-logo-128x128.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>
        <Button id="claudeButton" fx:id="claudeButton" onAction="#onSwitch" styleClass="provider-button">
            <graphic>
                <ImageView fitHeight="75.0" fitWidth="75.0">
                    <image>
                        <Image url="@claude-logo-128x128.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>
        <Button id="geminiButton" fx:id="geminiButton" onAction="#onSwitch" styleClass="provider-button">
            <graphic>
                <ImageView fitHeight="75.0" fitWidth="75.0">
                    <image>
                        <Image url="@gemini-logo-128x128.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>
        <Button id="mistralButton" fx:id="mistralButton" onAction="#onSwitch" styleClass="provider-button">
            <graphic>
                <ImageView fitHeight="75.0" fitWidth="75.0">
                    <image>
                        <Image url="@mistral-logo-128x128.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>
        <Button id="perplexityButton" fx:id="perplexityButton" onAction="#onSwitch" styleClass="provider-button">
            <graphic>
                <ImageView fitHeight="75.0" fitWidth="75.0">
                    <image>
                        <Image url="@perplexity-logo-128x128.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>
    </children>
   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
</VBox>
